{
  "name": "dsh-healthkit-report",
  "version": "0.1.1",
  "description": "Apple Health export analysis for DeepSeek Harness: parse export.xml, de-duplicate device records, build DOCX/XLSX/HTML reports.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "apple-health",
    "healthkit",
    "health-report"
  ],
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "python/**"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/little-fire9552/dsh-healthkit-report.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/copy-python.mjs",
    "prepack": "node scripts/copy-python.mjs"
  }
}
